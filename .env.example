# Required for app identity and secure session signing.
VITE_APP_ID=replace-with-your-app-id
JWT_SECRET=replace-with-a-long-random-secret

# Required for login. Configure the OAuth provider's callback URL as:
# https://YOUR-DOMAIN/api/oauth/callback
OAUTH_SERVER_URL=https://replace-with-your-oauth-server

# Required for persistent property/user data. Use a Neon-compatible PostgreSQL URL.
# The app accepts either variable; SUPABASE_DATABASE_URL takes precedence.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional: grants the matching account owner/admin privileges.
OWNER_OPEN_ID=

# Optional Manus API-backed AI, maps, notification, and storage features.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
